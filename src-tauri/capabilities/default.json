{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal (Windows y Android) y de las que se abren con «Abrir en una ventana nueva» (ventana-1, ventana-2…)",
  "windows": ["main", "ventana-*"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "fs:default",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-applocaldata-write-recursive",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "http://*/*" },
        { "url": "http://*:*" },
        { "url": "http://*:*/*" },
        { "url": "https://*" },
        { "url": "https://*/*" },
        { "url": "https://*:*" },
        { "url": "https://*:*/*" }
      ]
    }
  ]
}
