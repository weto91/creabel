{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Creabel",
  "version": "0.1.0",
  "identifier": "io.github.weto91.creabel",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Creabel",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/archivos/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "publisher": "Álvaro Rubio Adán",
    "copyright": "© Álvaro Rubio Adán. Licencia GPL v3 con términos adicionales de atribución.",
    "category": "Productivity",
    "shortDescription": "El taller de tu novela",
    "longDescription": "Creabel organiza la escritura de una novela: capítulos y escenas, personajes, lugares, línea temporal, continuidad, análisis y exportación.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/weto91/creabel/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
